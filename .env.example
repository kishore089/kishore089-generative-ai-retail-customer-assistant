# Environment configuration for the Retail Customer Assistant frontend.
# Copy this file to `.env` (or `.env.local`) and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the client by Vite.

# Backend API base URL (Customer Profile API on API Gateway).
# Required.
VITE_API_BASE_URL=https://mt3oqpg1pd.execute-api.us-east-1.amazonaws.com/prod

# Amazon Lex chat endpoint used by the AI Assistant page.
# Absolute URL overrides the shared API base URL; omit to resolve "/lex"
# against VITE_API_BASE_URL. Example:
VITE_LEX_API_URL=https://mt3oqpg1pd.execute-api.us-east-1.amazonaws.com/prod/lex

# Amazon Cognito authentication (User Pool). Required.
VITE_COGNITO_USER_POOL_ID=us-east-1_IXXCBONsn
VITE_COGNITO_CLIENT_ID=4ueeicjim4f1juhk421k2hvdcc
VITE_COGNITO_REGION=us-east-1
