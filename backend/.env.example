# Copy values into your deployment configuration / secret manager as appropriate.
# Do not commit real values or use this file as a Lambda environment file.
AWS_REGION=us-east-1

# DynamoDB tables — verify each actual deployed table name and key schema.
CUSTOMERS_TABLE=Customers
PRODUCTS_TABLE=Products
ORDERS_TABLE=Ordersai
INVENTORY_TABLE=Inventory
PAYMENTS_TABLE=Payments
RETURNS_TABLE=Returns
SUPPORT_TICKETS_TABLE=SupportTickets
ANALYTICS_TABLE=ConversationAnalytics

# Bedrock Agent bridge
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Lex web API
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=en_US

# Configurable key-field names (comma-separated candidates)
CUSTOMER_KEY_FIELDS=CustomerID,CustomerId,customerId,Email,email
PRODUCT_KEY_FIELDS=ProductsID,ProductID,ProductId,productId,SKU,sku,ProductName
ORDER_KEY_FIELDS=OrdersID,OrderID,OrderId,orderId,TrackingID,TrackingNumber,CustomerID
INVENTORY_KEY_FIELDS=ProductsID,ProductID,ProductId,productId,SKU,sku,InventoryID,ItemID
PAYMENT_KEY_FIELDS=PaymentID,PaymentId,paymentId,OrdersID,OrderID,CustomerID
RETURN_KEY_FIELDS=ReturnID,ReturnId,returnId,OrdersID,OrderID,CustomerID
SUPPORT_KEY_FIELDS=SupportTicketID,TicketID,TicketId,ticketId,CustomerID,OrderID

# Order update/cancellation key and status attributes
ORDER_PRIMARY_KEY=OrdersID
ORDER_STATUS_FIELD=OrderStatus

# Search / scan controls
CUSTOMER_ID_FIELD=CustomerID
CUSTOMER_EMAIL_FIELD=Email
CUSTOMER_PHONE_FIELD=Phone
CUSTOMER_SEARCH_SCAN_LIMIT=100
ANALYTICS_SCAN_LIMIT=1000

# Optional
LOG_LEVEL=INFO
CORS_ALLOW_ORIGIN=
CONNECT_INSTANCE_ID=
CONNECT_ESCALATION_QUEUE_ID=
